                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The user-provided file, in one of the following formats: XLS, XLSX, or CSV.\n"
