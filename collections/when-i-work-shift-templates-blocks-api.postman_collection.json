    {
      "id": "38619d1d-0744-4231-ae78-a2ab43d32768",
      "name": "Shift Templates (Blocks)",
      "description": {
        "content": "Shift templates save you time when you need to schedule shifts that have a consistent start and end time. Instead of manually entering in custom shift details one-by-one, shift templates allow you to schedule a shift quickly and easily.\n\nFor more information about using Shift Templates, visit the [Help Center](https://help.wheniwork.com/articles/creating-and-managing-shift-templates-computer/).\n",
        "type": "text/plain"
      },
