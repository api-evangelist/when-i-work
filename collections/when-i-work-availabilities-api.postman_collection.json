    {
      "id": "7f6d83ea-2894-4e7f-9790-0a2540cfb71a",
      "name": "Availabilities",
      "description": {
        "content": "Set your availability preferences to let your employer know when you prefer to work and when you prefer not to work.\n\nFor more information about using Availabilities, visit the [Help Center](https://help.wheniwork.com/articles/setting-your-availability-computer/).\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e3d4d7cb-9b33-4624-970f-b3aeb88a13a0",
          "name": "List Availability Events",
          "request": {
            "name": "List Availability Events",
            "description": {
              "content": "Get a list of availability events based on a set of filters. Requests date ranges will include events with recurrence patterns within the date range. Requests will be submitted with the supplied date range and the response will be in the requesting users timezone.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "2",
                "availabilityevents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "The start of the filter range. Defaults to \"now\""
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "The end of the filter range. Defaults to \"two weeks from now\""
                },
                {
                  "disabled": false,
                  "key": "user_id",
                  "value": "<integer>",
                  "description": "The optional User ID who's events you wish to fetch. If omitted, uses the calling user's ID"
                },
                {
                  "disabled": false,
                  "key": "include_all",
                  "value": "<boolean>",
                  "description": "Whether to include all availability data instead of just the requestor's. Only valid for managers"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
