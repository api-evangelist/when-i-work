    {
      "id": "3ac6623b-984a-4c5b-bc53-8dfad18e7858",
      "name": "Positions",
      "description": {
        "content": "Positions (aka, job or duty) are used to define labor allocation. Users can be tagged (associated) with one or more Positions. When I Work uses this association for shift eligibility, Alert notifications filtering and labor reporting.\n\nFor more information about using Positions, visit the [Help Center](https://help.wheniwork.com/articles/creating-and-managing-positions-computer/).\n",
        "type": "text/plain"
      },
